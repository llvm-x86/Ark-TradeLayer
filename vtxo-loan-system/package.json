{
  "name": "vtxo-loan-system",
  "version": "0.1.0",
  "description": "Bitcoin-native loan platform using VTXOs, DLCs, and cryptographic oracles",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "start": "node dist/index.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:integration": "jest --testPathPattern=tests/integration",
    "lint": "eslint src/ --ext .ts",
    "lint:fix": "eslint src/ --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "migrate": "ts-node scripts/migrate-database.ts",
    "seed": "ts-node scripts/seed-data.ts"
  },
  "keywords": [
    "bitcoin",
    "dlc",
    "vtxo",
    "ark",
    "oracle",
    "lending",
    "defi"
  ],
  "author": "TradeLayer",
  "license": "MIT",
  "dependencies": {
    "@node-lightning/crypto": "^0.15.0",
    "@node-dlc/messaging": "^0.8.0",
    "axios": "^1.6.0",
    "bip32": "^4.0.0",
    "bip39": "^3.1.0",
    "bitcoin-networks": "^2.0.0",
    "bullmq": "^4.15.0",
    "cfd-js": "^0.3.0",
    "dotenv": "^16.3.1",
    "ethers": "^6.9.0",
    "express": "^4.18.2",
    "ioredis": "^5.3.2",
    "lodash": "^4.17.21",
    "mongoose": "^8.0.3",
    "mongoose-paginate-v2": "^1.8.0",
    "neverthrow": "^6.1.0",
    "pino": "^8.16.2",
    "pino-pretty": "^10.2.3",
    "tiny-secp256k1": "^2.2.3"
  },
  "devDependencies": {
    "@google-cloud/kms": "^4.1.0",
    "@google-cloud/secret-manager": "^5.0.1",
    "@aws-sdk/client-secrets-manager": "^3.470.0",
    "@types/bip32": "^2.0.0",
    "@types/bip39": "^3.0.0",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.11",
    "@types/lodash": "^4.14.202",
    "@types/node": "^20.10.6",
    "@typescript-eslint/eslint-plugin": "^6.16.0",
    "@typescript-eslint/parser": "^6.16.0",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.2",
    "jest": "^29.7.0",
    "prettier": "^3.1.1",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3"
  },
  "optionalDependencies": {
    "@google-cloud/kms": "^4.1.0",
    "@google-cloud/secret-manager": "^5.0.1",
    "@aws-sdk/client-secrets-manager": "^3.470.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/vtxo-loan-system.git"
  },
  "bugs": {
    "url": "https://github.com/yourusername/vtxo-loan-system/issues"
  },
  "homepage": "https://github.com/yourusername/vtxo-loan-system#readme"
}
