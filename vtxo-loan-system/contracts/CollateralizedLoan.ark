/**
 * Collateralized Loan Contract
 * 
 * A VTXO-based loan with Bitcoin collateral and DLC-based liquidation.
 * 
 * Parties:
 * - Lender: Provides the loan principal
 * - Borrower: Receives principal, provides collateral
 * - Server: ASP (Ark Service Provider) for cooperative settlement
 * - Oracle: Provides price attestations for liquidation
 * 
 * Outcomes:
 * 1. Full Repayment: Borrower repays, gets collateral back
 * 2. Partial Repayment: Pro-rata split of collateral
 * 3. Liquidation: Collateral value dropped below threshold
 * 4. Default: Loan term expired without repayment
 */

// Contract configuration
options {
  server = server;
  exit = 1008; // 1 week exit delay for unilateral path
}

contract CollateralizedLoan(
  // Party public keys
  pubkey lender,
  pubkey borrower,
  pubkey server,
  pubkey oracleKey,
  
  // Loan terms (hashed for privacy)
  bytes32 loanTermsHash,
  
  // Oracle event IDs - each is sha256(utf8(eventId)) (the canonical 32-byte
  // event id commitment, see tagged-hash.ts hashEventId); attestation blobs
  // carry the same value in their leading 32 bytes
  bytes32 repaymentOracleId,
  bytes32 priceOracleId,
  
  // Oracle event commitments (v1 attestation format: the descriptor and
  // maturity are signed alongside the outcome, so the loan must pin them)
  bytes32 repaymentDescriptorHash,
  bytes32 priceDescriptorHash,
  int oracleMaturity,
  
  // Amounts and thresholds
  int principalAmount,
  int collateralAmount,
  int liquidationThreshold,
  
  // Timing
  int loanMaturity,
  int gracePeriod
) {
  
  /**
   * Full Repayment Path
   * 
   * Borrower repays the full amount, oracle confirms payment,
   * borrower receives collateral back.
   */
  function repayFull(
    signature borrowerSig,
    signature lenderSig,
    bytes oracleAttestation
  ) {
    // Verify oracle attests to full repayment
    bytes32 attestationHash = sha256(oracleAttestation);
    require(
      verifyOracleAttestation(oracleAttestation, repaymentOracleId, repaymentDescriptorHash, oracleMaturity, "paid"),
      "Oracle must confirm payment"
    );
    
    // Verify both parties agree
    require(checkSig(borrowerSig, borrower), "Invalid borrower signature");
    require(checkSig(lenderSig, lender), "Invalid lender signature");
    
    // Output 0: Return collateral to borrower
    require(
      tx.outputs[0].value >= collateralAmount,
      "Must return full collateral"
    );
    require(
      tx.outputs[0].scriptPubKey == new P2TR(borrower),
      "Collateral must go to borrower"
    );
  }
  
  /**
   * Partial Repayment Path
   * 
   * Borrower repays partial amount, collateral is split pro-rata.
   */
  function repayPartial(
    signature borrowerSig,
    signature lenderSig,
    bytes oracleAttestation,
    int repaidAmount
  ) {
    // Verify payment confirmation
    require(
      verifyOracleAttestation(oracleAttestation, repaymentOracleId, repaymentDescriptorHash, oracleMaturity, "paid"),
      "Oracle must confirm payment"
    );
    
    // Verify repaid amount is between 0 and principal
    require(repaidAmount > 0, "Must repay some amount");
    require(repaidAmount < principalAmount, "Use repayFull for full repayment");
    
    // Calculate pro-rata splits
    int repaymentRatio = (repaidAmount * 1000000) / principalAmount;
    int lenderShare = (collateralAmount * (1000000 - repaymentRatio)) / 1000000;
    int borrowerShare = collateralAmount - lenderShare;
    
    // Verify signatures
    require(checkSig(borrowerSig, borrower), "Invalid borrower signature");
    require(checkSig(lenderSig, lender), "Invalid lender signature");
    
    // Output 0: Borrower's share
    require(
      tx.outputs[0].value >= borrowerShare,
      "Incorrect borrower share"
    );
    require(
      tx.outputs[0].scriptPubKey == new P2TR(borrower),
      "Borrower share must go to borrower"
    );
    
    // Output 1: Lender's share
    require(
      tx.outputs[1].value >= lenderShare,
      "Incorrect lender share"
    );
    require(
      tx.outputs[1].scriptPubKey == new P2TR(lender),
      "Lender share must go to lender"
    );
  }
  
  /**
   * Liquidation Path
   * 
   * Collateral value dropped below liquidation threshold.
   * Lender can claim collateral before maturity.
   */
  function liquidate(
    signature lenderSig,
    bytes priceAttestation
  ) {
    // Verify oracle attests that price hit liquidation threshold
    require(
      verifyOracleAttestation(priceAttestation, priceOracleId, priceDescriptorHash, oracleMaturity, "hit"),
      "Liquidation threshold not reached"
    );
    
    // Verify lender signature
    require(checkSig(lenderSig, lender), "Invalid lender signature");
    
    // Output 0: All collateral to lender
    require(
      tx.outputs[0].value >= collateralAmount,
      "Must transfer full collateral"
    );
    require(
      tx.outputs[0].scriptPubKey == new P2TR(lender),
      "Collateral must go to lender"
    );
  }
  
  /**
   * Default Path
   * 
   * Loan matured without repayment. After grace period,
   * lender can claim collateral.
   */
  function claimDefault(signature lenderSig) {
    // Verify we're past maturity + grace period
    int defaultTime = loanMaturity + gracePeriod;
    require(tx.time >= defaultTime, "Grace period not expired");
    
    // Verify lender signature
    require(checkSig(lenderSig, lender), "Invalid lender signature");
    
    // Output 0: All collateral to lender
    require(
      tx.outputs[0].value >= collateralAmount,
      "Must transfer full collateral"
    );
    require(
      tx.outputs[0].scriptPubKey == new P2TR(lender),
      "Collateral must go to lender"
    );
  }
  
  /**
   * Borrower Emergency Exit
   * 
   * If server is unavailable, borrower can exit unilaterally
   * after timelock, but loses a penalty.
   */
  function emergencyExit(signature borrowerSig) {
    // Must wait for exit delay (defined in options)
    require(tx.age >= exit, "Exit timelock not satisfied");
    
    // Verify borrower signature
    require(checkSig(borrowerSig, borrower), "Invalid borrower signature");
    
    // Penalty: 10% of collateral goes to lender
    int penalty = collateralAmount / 10;
    int borrowerReceives = collateralAmount - penalty;
    
    // Output 0: Borrower receives collateral minus penalty
    require(
      tx.outputs[0].value >= borrowerReceives,
      "Incorrect borrower amount"
    );
    require(
      tx.outputs[0].scriptPubKey == new P2TR(borrower),
      "Must go to borrower"
    );
    
    // Output 1: Penalty to lender
    require(
      tx.outputs[1].value >= penalty,
      "Incorrect penalty amount"
    );
    require(
      tx.outputs[1].scriptPubKey == new P2TR(lender),
      "Penalty must go to lender"
    );
  }
  
  /**
   * Helper: Verify oracle attestation
   *
   * v1 attestation blob format:
   *   eventIdHash(32) || descriptorHash(32) || maturityTime(8 BE) || outcome(var) || signature(64)
   *
   * where eventIdHash = sha256(utf8(eventId)) - the canonical 32-byte event
   * id commitment (vtxo-loan-system/src/crypto/tagged-hash.ts, hashEventId).
   * The loan's pinned `repaymentOracleId` / `priceOracleId` contract
   * parameters ARE this sha256(utf8(eventId)) value.
   */
  function verifyOracleAttestation(
    bytes attestation,
    bytes32 eventId,
    bytes32 expectedDescriptorHash,
    int expectedMaturity,
    bytes expectedOutcome
  ) returns (bool) {
    // Parse attestation structure
    bytes32 attestedEventId = attestation.split(32)[0];
    bytes32 descriptorHash = attestation.split(32)[1].split(32)[0];
    bytes maturityTime = attestation.split(32)[1].split(32)[1].split(8)[0];
    bytes outcome = attestation.split(32)[1].split(32)[1].split(8)[1].split(64)[0];
    bytes64 signature = attestation.split(32)[1].split(32)[1].split(8)[1].split(64)[1];
    
    // Verify event ID matches (both sides are sha256(utf8(eventId)))
    if (attestedEventId != eventId) return false;
    
    // The descriptor and maturity are covered by the signature and must match
    // the terms this loan committed to
    if (descriptorHash != expectedDescriptorHash) return false;
    if (maturityTime != uint64be(expectedMaturity)) return false;
    
    // Verify outcome matches expected
    if (outcome != expectedOutcome) return false;
    
    // Verify oracle signature over the v1 attestation message.
    //
    // The on-chain matcher MUST implement the exact same canonical
    // serialization as the off-chain signer
    // (vtxo-loan-system/src/attestation/attestation-engine.ts,
    // serializeAttestationMessage): every field is a 4-byte big-endian length
    // prefix followed by the field bytes, in this order:
    //   lenpfx(eventIdHash) || lenpfx(oraclePubkeyXonly) || lenpfx(descriptorHash)
    //   || lenpfx(maturityTime as uint64 BE) || lenpfx(outcome)
    // and the result is hashed with a BIP-340 tagged hash
    // (sha256(sha256(tag) || sha256(tag) || msg)) under the tag
    // "DLC/oracle/attestation/v1".
    //
    // Field encodings (must match byte-for-byte):
    //   eventIdHash       = attestedEventId, the 32-byte sha256(utf8(eventId))
    //   oraclePubkeyXonly = xonly(oracleKey), 32 bytes (NOT the 33-byte
    //                       compressed key)
    //   descriptorHash    = 32 raw bytes
    //   maturityTime      = uint64 big-endian, 8 bytes
    //   outcome           = utf8 bytes of the outcome string (printable ASCII)
    //
    // Byte-exact reference vectors both sides must reproduce:
    //   vtxo-loan-system/tests/vectors/attestation-vectors.json
    //
    // NOTE: this replaces the old v0 scheme
    // sha256("DLC/oracle/attestation/v0" || outcome), which signed only the
    // outcome string and was therefore replayable across every loan sharing
    // the oracle key (see issue #1 / C1). Signatures under the v0 tag are
    // intentionally invalid.
    bytes32 messageHash = taggedHash(
      "DLC/oracle/attestation/v1",
      lenpfx(bytes(attestedEventId)) || lenpfx(bytes(xonly(oracleKey)))
        || lenpfx(bytes(descriptorHash)) || lenpfx(maturityTime) || lenpfx(outcome)
    );
    
    return checkSchnorrSig(signature, xonly(oracleKey), messageHash);
  }
}
