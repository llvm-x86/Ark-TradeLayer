/**
 * Unsecured Loan Contract
 * 
 * A trust-based loan without collateral, using reputation oracles
 * and social recovery mechanisms.
 * 
 * Outcomes:
 * 1. Repayment: Borrower repays, reputation improves
 * 2. Default: Borrower defaults, reputation damaged
 * 3. Dispute: Multi-sig arbitration resolves conflict
 */

options {
  server = server;
  exit = 2016; // 2 weeks exit delay
}

contract UnsecuredLoan(
  // Parties
  pubkey lender,
  pubkey borrower,
  pubkey server,
  pubkey oracleKey,
  pubkey arbitrator, // Optional third-party arbitrator
  
  // Loan terms
  bytes32 loanTermsHash,
  bytes32 repaymentOracleId,
  
  // Oracle event commitments (v1 attestation format: the descriptor and
  // maturity are signed alongside the outcome, so the loan must pin them)
  bytes32 repaymentDescriptorHash,
  int repaymentMaturity,
  
  // Amounts
  int principalAmount,
  int interestAmount,
  
  // Timing
  int loanMaturity,
  int repaymentDeadline
) {
  
  /**
   * Full Repayment Path
   * 
   * Borrower repays principal + interest on time.
   */
  function repay(
    signature borrowerSig,
    signature lenderSig,
    bytes oracleAttestation
  ) {
    // Verify oracle confirms payment
    require(
      verifyRepayment(oracleAttestation, repaymentDescriptorHash, repaymentMaturity, "paid"),
      "Payment not confirmed"
    );
    
    // Verify both parties sign off
    require(checkSig(borrowerSig, borrower), "Invalid borrower signature");
    require(checkSig(lenderSig, lender), "Invalid lender signature");
    
    // Funds are already transferred off-chain via oracle verification
    // This spending path simply closes the VTXO
  }
  
  /**
   * Partial Repayment Path
   * 
   * Borrower repays partial amount, negotiated settlement.
   */
  function repayPartial(
    signature borrowerSig,
    signature lenderSig,
    bytes oracleAttestation,
    int repaidAmount
  ) {
    require(
      verifyRepayment(oracleAttestation, repaymentDescriptorHash, repaymentMaturity, "paid"),
      "Payment not confirmed"
    );
    
    require(
      repaidAmount > 0 && repaidAmount < (principalAmount + interestAmount),
      "Invalid partial amount"
    );
    
    // Both parties must agree to partial settlement
    require(checkSig(borrowerSig, borrower), "Invalid borrower signature");
    require(checkSig(lenderSig, lender), "Invalid lender signature");
  }
  
  /**
   * Default Path
   * 
   * Borrower failed to repay by deadline. Lender can trigger default
   * which damages borrower's on-chain reputation.
   */
  function triggerDefault(signature lenderSig) {
    // Must be past repayment deadline
    require(
      tx.time >= repaymentDeadline,
      "Repayment deadline not reached"
    );
    
    require(checkSig(lenderSig, lender), "Invalid lender signature");
    
    // Output 0: Send to reputation contract
    // This contract records the default on-chain, affecting borrower's credit
    bytes reputationScript = buildReputationScript(borrower, lender, principalAmount);
    require(
      tx.outputs[0].scriptPubKey == reputationScript,
      "Must record default in reputation contract"
    );
  }
  
  /**
   * Dispute Resolution Path
   * 
   * If there's a disagreement, arbitrator can resolve.
   * Requires 2-of-3 signatures: borrower, lender, arbitrator.
   */
  function resolveDispute(
    signature sig1,
    signature sig2,
    pubkey signer1,
    pubkey signer2,
    bytes resolutionData
  ) {
    // Verify we have 2-of-3 valid signatures
    int validSigs = 0;
    
    if (checkSig(sig1, signer1)) {
      require(
        signer1 == borrower || signer1 == lender || signer1 == arbitrator,
        "Invalid signer 1"
      );
      validSigs = validSigs + 1;
    }
    
    if (checkSig(sig2, signer2)) {
      require(
        signer2 == borrower || signer2 == lender || signer2 == arbitrator,
        "Invalid signer 2"
      );
      require(signer1 != signer2, "Cannot reuse same signer");
      validSigs = validSigs + 1;
    }
    
    require(validSigs >= 2, "Need 2-of-3 signatures");
    
    // Resolution data specifies outcome (encoded as compact struct)
    // Format: outcometype(1) || borrowerAmount(8) || lenderAmount(8)
    bytes1 outcomeType = resolutionData.split(1)[0];
    
    if (outcomeType == 0x01) {
      // Resolved in borrower's favor
      // Funds released back to borrower or debt forgiven
    } else if (outcomeType == 0x02) {
      // Resolved in lender's favor
      // Default recorded, reputation damaged
    } else if (outcomeType == 0x03) {
      // Split resolution
      // Both parties get something
    }
  }
  
  /**
   * Extension Path
   * 
   * Borrower requests loan extension, lender approves.
   * Creates a new VTXO with updated terms.
   */
  function extendLoan(
    signature borrowerSig,
    signature lenderSig,
    int newDeadline,
    int additionalInterest
  ) {
    require(
      tx.time < repaymentDeadline,
      "Cannot extend after deadline"
    );
    
    require(
      newDeadline > repaymentDeadline,
      "New deadline must be later"
    );
    
    require(checkSig(borrowerSig, borrower), "Invalid borrower signature");
    require(checkSig(lenderSig, lender), "Invalid lender signature");
    
    // Output 0: New VTXO with updated terms
    bytes32 newTermsHash = sha256(
      loanTermsHash || 
      bytes(newDeadline) || 
      bytes(additionalInterest)
    );
    
    bytes newContractScript = buildLoanScript(
      lender,
      borrower,
      newTermsHash,
      newDeadline
    );
    
    require(
      tx.outputs[0].scriptPubKey == newContractScript,
      "Must create new loan VTXO"
    );
  }
  
  /**
   * Emergency Exit
   * 
   * Unilateral exit if server is unavailable.
   */
  function emergencyExit(signature partySig, pubkey party) {
    require(tx.age >= exit, "Exit timelock not satisfied");
    require(
      party == borrower || party == lender,
      "Must be a party to the contract"
    );
    require(checkSig(partySig, party), "Invalid signature");
    
    // In unsecured loan, no collateral to split
    // This path just closes the VTXO and records the state
  }
  
  /**
   * Helper: Verify repayment oracle attestation
   *
   * v1 attestation blob format:
   *   eventId(32) || descriptorHash(32) || maturityTime(8 BE) || outcome(var) || signature(64)
   */
  function verifyRepayment(
    bytes attestation,
    bytes32 expectedDescriptorHash,
    int expectedMaturity,
    bytes expectedOutcome
  ) returns (bool) {
    bytes32 attestedEventId = attestation.split(32)[0];
    bytes32 descriptorHash = attestation.split(32)[1].split(32)[0];
    bytes maturityTime = attestation.split(32)[1].split(32)[1].split(8)[0];
    bytes outcome = attestation.split(32)[1].split(32)[1].split(8)[1].split(64)[0];
    bytes64 signature = attestation.split(32)[1].split(32)[1].split(8)[1].split(64)[1];
    
    if (attestedEventId != repaymentOracleId) return false;
    if (descriptorHash != expectedDescriptorHash) return false;
    if (maturityTime != uint64be(expectedMaturity)) return false;
    if (outcome != expectedOutcome) return false;
    
    // v1 attestation message — MUST match the off-chain canonical
    // serialization byte-for-byte (see
    // vtxo-loan-system/src/attestation/attestation-engine.ts,
    // serializeAttestationMessage): each field is uint32_be(len) || bytes, in
    // the order eventId, oraclePubkey, descriptorHash, maturityTime(u64 BE),
    // outcome, hashed with a BIP-340 tagged hash under
    // "DLC/oracle/attestation/v1". The v0 scheme
    // (sha256("DLC/oracle/attestation/v0" || outcome)) signed only the
    // outcome and was replayable across loans — do not reintroduce it
    // (see issue #1 / C1).
    bytes32 messageHash = taggedHash(
      "DLC/oracle/attestation/v1",
      lenpfx(bytes(attestedEventId)) || lenpfx(bytes(oracleKey))
        || lenpfx(bytes(descriptorHash)) || lenpfx(maturityTime) || lenpfx(outcome)
    );
    return checkSchnorrSig(signature, oracleKey, messageHash);
  }
  
  /**
   * Helper: Build reputation contract script
   */
  function buildReputationScript(
    pubkey defaulter,
    pubkey creditor,
    int defaultAmount
  ) returns (bytes) {
    // Reputation contract receives default record
    // This is an OP_RETURN output or covenant to reputation registry
    return new OpReturn(
      bytes("DEFAULT") ||
      defaulter ||
      creditor ||
      bytes(defaultAmount) ||
      bytes(tx.time)
    );
  }
  
  /**
   * Helper: Build new loan script for extension
   */
  function buildLoanScript(
    pubkey lender,
    pubkey borrower,
    bytes32 termsHash,
    int deadline
  ) returns (bytes) {
    // Recursively create the same contract type with new parameters
    // This allows loan terms to evolve while maintaining structure
    return new P2TR(
      internalKey: borrower,
      scriptTree: [
        // Recursive covenant maintaining loan structure
        this.script
      ]
    );
  }
}
