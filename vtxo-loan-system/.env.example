# =========================================
# VTXO Loan System Configuration
# =========================================

# ---------------
# Network Settings
# ---------------
# Options: mainnet, testnet, regtest, signet
NETWORK=regtest

# Options: development, staging, production
ORACLE_MODE=development

# ---------------
# Key Management
# ---------------
# Options: local, gcp, aws, mock
KEY_PROVIDER=local

# For local provider (development only)
MNEMONIC=abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon about

# For cloud providers (production)
# CLOUD_PROJECT_ID=my-project-id
# CLOUD_SECRET_ID=oracle-mnemonic

# ---------------
# Database
# ---------------
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=vtxo-loans
MONGODB_POOL_SIZE=10

# ---------------
# Redis (Job Queue)
# ---------------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# REDIS_PASSWORD=your-redis-password
REDIS_DB=0

# ---------------
# External Data Sources
# ---------------

# Price Feeds
# COINGECKO_API_KEY=your-api-key
# COINBASE_API_KEY=your-api-key
PRICE_FEED_SOURCES=coingecko,coinbase,kraken

# Ethereum Integration
ETHEREUM_ENABLED=true
# ALCHEMY_API_KEY=your-alchemy-key
# INFURA_API_KEY=your-infura-key
ETH_NETWORKS=mainnet,sepolia

# Bitcoin RPC (optional)
# BITCOIN_RPC_URL=http://localhost:8332
# BITCOIN_RPC_USER=bitcoinrpc
# BITCOIN_RPC_PASSWORD=your-password

# ---------------
# API Server
# ---------------
PUBLIC_API_PORT=3000
INTERNAL_API_PORT=3001
API_AUTH_KEY=dev-key-insecure

# CORS Configuration
CORS_ENABLED=true
CORS_ORIGINS=*

# ---------------
# Monitoring & Logging
# ---------------
LOG_LEVEL=info

# Error Tracking (optional)
# SENTRY_DSN=https://your-sentry-dsn

# Alerts (optional)
# SLACK_WEBHOOK=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# ---------------
# Scheduler Configuration
# ---------------
# How often to check prices (minutes)
PRICE_CHECK_INTERVAL=5

# How often to check payments (minutes)
PAYMENT_CHECK_INTERVAL=2

# How many weeks ahead to create announcements
ANNOUNCEMENT_LOOKAHEAD=13

# ---------------
# VTXO Configuration
# ---------------
# Exit delay for unilateral paths (blocks)
VTXO_EXIT_DELAY=1008

# ASP server public key (hex)
# VTXO_SERVER_PUBKEY=02a1b2c3d4e5f6...

# Minimum contract value (satoshis)
MIN_CONTRACT_VALUE=10000

# ---------------
# Security
# ---------------
# Rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_MS=60000

# Request size limits
MAX_REQUEST_SIZE=10mb

# Session timeout (seconds)
SESSION_TIMEOUT=3600
